# ============================================================
# Backend Environment Variables (.env inside /backend)
# ============================================================
PORT=8000

# Google Gemini API Key (Get a free key from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# JWT Secret Key for session tokens
JWT_SECRET_KEY=my_super_secret_jwt_key_for_dev

# Database Connection URL (MongoDB URI or Atlas connection string)
DATABASE_URL=mongodb://localhost:27017/ai_resume_analyzer
MONGODB_DB_NAME=ai_resume_analyzer

# Optional Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here

# ============================================================
# Frontend Environment Variables (.env.local inside /frontend)
# ============================================================
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
